# Copie para .env e ajuste os valores.
# Em produção (Square Cloud), configure essas mesmas variáveis
# na aba "Environment Variables" do painel da aplicação —
# o .env não é versionado nem enviado no deploy.

# true/false — controla a flag `secure` dos cookies de sessão.
# Deixe "true" em produção (Square Cloud serve a app via HTTPS).
HTTPS=true

# true/false — habilita as rotas /demo/* sem exigir login.
# Recomendado "false" em produção.
DEMO_ENABLED=false
